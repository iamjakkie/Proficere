# Copy to .env and supply your own values. Never commit .env.
# Generative AI uses OpenRouter only. There is no fallback provider.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Bind to localhost by default. Do not expose this unauthenticated library.
HOST=127.0.0.1
PORT=3001
CLIENT_PORT=5173

# SQLite path (created automatically)
DATABASE_PATH=./data/progress-island.db

# Folder of your own text-based book PDFs. The server reads chapters from here.
# Example: LIBRARY_PATH=/Users/you/Books
LIBRARY_PATH=
