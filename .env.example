# Copy to .env and supply your own values. Never commit .env.
# Generative AI uses OpenRouter only. There is no fallback provider.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Bind to localhost by default. Do not expose this unauthenticated library.
# Use other ports to run this branch beside the current app: PORT=3011 and CLIENT_PORT=5183.
HOST=127.0.0.1
PORT=3001
CLIENT_PORT=5173

# SQLite path (created automatically)
DATABASE_PATH=./data/progress-island.db

# Folder of your own text-based book PDFs. The server reads chapters from here.
# Example: LIBRARY_PATH=/Users/you/Books
LIBRARY_PATH=

# Exercise-sheet search. Both values stay on the server. Never put the key in frontend code.
# The endpoint should accept GET ?q= and Authorization: Bearer, and return
# { "items": [{ "title": "...", "url": "https://host/sheet.pdf" }] }.
# Without a key, Search now explains that search is not configured.
EXERCISE_SEARCH_ENDPOINT=
EXERCISE_SEARCH_API_KEY=
